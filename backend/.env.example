# MongoDB Connection URI (e.g., local MongoDB or MongoDB Atlas cluster)
MONGO_URI=mongodb://127.0.0.1:27017/telecrm

# Backend Server Port (defaults to 5000)
PORT=5000

# JSON Web Token Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Allowed Frontend Origin for CORS (e.g., http://localhost:5174 in dev)
FRONTEND_URL=http://localhost:5174

# Initial Admin Credentials (used by node seed.js to initialize first admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# Optional Cookie Security (set to true when running under HTTPS in production)
COOKIE_SECURE=false

